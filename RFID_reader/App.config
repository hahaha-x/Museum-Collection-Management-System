<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- SDK 基于旧 CLR，程序在 Windows 的 .NET Framework 4.8 上运行，不依赖 Java。 -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="ReaderIp" value="192.168.1.100" />
    <add key="ReaderPort" value="23" />
    <add key="Username" value="alien" />
    <!-- 可用 RFID_PASSWORD 环境变量覆盖；不要在日志中输出密码。 -->
    <add key="Password" value="password" />
    <!-- 0 起始编号；截图是 Ant:3。只填写实际接好 RFID 天线的端口。 -->
    <add key="Antennas" value="0,1,2,3" />
    <add key="PollIntervalMs" value="1000" />
    <add key="ReconnectIntervalMs" value="3000" />
    <add key="OutputDirectory" value="data" />
    <!-- 接口只监听本机；网页后端调用，不允许浏览器跨域直连。 -->
    <add key="ApiPort" value="5080" />
    <!-- 旧观测不会伪装成实时数据；单次扫描等待包含排队和设备调用。 -->
    <add key="FreshnessMs" value="5000" />
    <add key="ScanTimeoutMs" value="90000" />
    <add key="ScanRetentionMs" value="600000" />
  </appSettings>
</configuration>
